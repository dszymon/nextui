// Mixins and Variables for Stylus

// Spacing
$spacing-1 = 0.25rem
$spacing-2 = 0.5rem
$spacing-3 = 0.75rem
$spacing-4 = 1rem
$spacing-5 = 1.25rem
$spacing-6 = 1.5rem
$spacing-8 = 2rem

// Radius
$radius-small = var(--heroui-radius-small)
$radius-medium = var(--heroui-radius-medium)
$radius-large = var(--heroui-radius-large)
$radius-full = 9999px

// Font Sizes
$font-tiny = 0.75rem
$font-small = 0.875rem
$font-medium = 1rem
$font-large = 1.125rem

// Colors helper function
color(name, shade = '')
  if shade
    var(--heroui- + name + '-' + shade)
  else
    var(--heroui- + name)
